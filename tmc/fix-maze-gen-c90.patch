 static inline void safe_write_tile_and_collision(MapLayer *layer, int layerIndex, int posX, int posY, u16 tileIndex, u8 collisionValue, int roomW, int roomH) {
     if (!layer) return;
     if (posX < 0 || posY < 0) return;
     if (posX >= 64 || posY >= 64) return;
 
     // Avoid writing outside the room's logical tile area
     if (posX >= roomW || posY >= roomH) return;
 
-    int pos = posY * 64 + posX;
+    int pos = posY * 64 + posX;
 
     // Call engine helper to set tile (this maintains engine-internal state that other systems may rely on)
     SetTile(tileIndex, pos, layerIndex);
 
     // Also update mapData raw entry (store the low 12 bits, preserve high bits if present)
     if (layer->mapData) {
         u16 old = layer->mapData[pos];
         layer->mapData[pos] = (old & 0xF000) | (tileIndex & 0x0FFF);
     }
 
     // Update collision override if present
     if (layer->collisionData) {
         layer->collisionData[pos] = collisionValue;
     }
 }
 
